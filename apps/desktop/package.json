{
  "name": "@schwabyio/gravity-desktop",
  "productName": "Gravity",
  "version": "0.14.4",
  "private": true,
  "description": "Gravity test automation, the desktop app.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/check-bundled-git.mjs && node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "predev:clean": "node scripts/check-bundled-git.mjs && node scripts/install-electron.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "electron-vite build",
    "prestart": "node scripts/check-bundled-git.mjs && node scripts/install-electron.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "pretest:e2e": "electron-vite build",
    "coverage:e2e": "node e2e-coverage.mjs"
  },
  "dependencies": {
    "@schwabyio/gravity-core": "*",
    "dugite": "3.2.3",
    "undici": "8.10.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "@playwright/test": "^1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "codemirror": "6.0.2",
    "electron": "44.4.3",
    "electron-vite": "5.0.0",
    "monocart-coverage-reports": "2.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  }
}
