{
  "name": "@schwabyio/gta",
  "version": "0.14.2",
  "type": "module",
  "description": "gta, the Gravity Test Automation command-line runner: HTTP API tests written as YAML files, run from a terminal or CI.",
  "keywords": [
    "api",
    "api-testing",
    "http",
    "rest",
    "testing",
    "test-automation",
    "cli",
    "yaml",
    "junit",
    "ci",
    "playwright"
  ],
  "license": "MIT",
  "homepage": "https://github.com/schwabyio/gravity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schwabyio/gravity.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/schwabyio/gravity/issues"
  },
  "bin": {
    "gta": "dist/gta.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.51.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@schwabyio/gravity-core": "*",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
